{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "ng build && cp dist/mulata/browser/index.csr.html dist/mulata/browser/index.html",
  "outputDirectory": "dist/mulata/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(avif|webp|jpg|jpeg|png|svg|mp4|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
